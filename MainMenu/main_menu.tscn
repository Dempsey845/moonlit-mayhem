[sub_resource type="Shader" id="Shader_scrim"]
code = "shader_type canvas_item;

void fragment() {
	float distance_from_center = abs(UV.x - 0.5) * 2.0;
	float opacity = mix(0.58, 0.09, smoothstep(0.12, 0.92, distance_from_center));
	COLOR = vec4(0.021, 0.016, 0.053, opacity);
}
"

